{
  "name": "pkmessenger",
  "productName": "PKMessenger",
  "version": "0.23.6",
  "description": "PKMessenger – Bot-Control-Center für Discord über die offizielle Bot-API",
  "main": "src/main/main.js",
  "private": true,
  "license": "MIT",
  "author": "pmorn",
  "repository": "github:Morni-Team/pkmessenger",
  "scripts": {
    "icon": "electron scripts/make-icon.js",
    "build:renderer": "node scripts/build-renderer.js",
    "start": "npm run build:renderer && node scripts/start.js",
    "demo": "npm run build:renderer && node scripts/start.js --demo",
    "package": "npm run build:renderer && electron-forge package",
    "make": "npm run build:renderer && electron-forge make",
    "publish": "npm run build:renderer && electron-forge publish",
    "update": "git pull --ff-only && npm install && npm run build:renderer",
    "test": "node --test --test-reporter=spec",
    "android:install": "npm ci --prefix mobile",
    "android:build": "node scripts/build-mobile.js && npm --prefix mobile exec cap sync android",
    "android:shots": "node scripts/build-mobile.js --demo && electron scripts/mobile-shots.js",
    "android:icons": "electron scripts/make-android-icons.js"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "@noble/curves": "1.9.7",
    "discord.js": "14.27.0",
    "qrcode-generator": "2.0.4",
    "tweetnacl": "1.0.3",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/publisher-github": "8.0.1",
    "electron": "44.6.0",
    "esbuild": "0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-window": "2.3.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.4": true
  }
}
